{
  "name": "hopup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "build:next": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./src/lib/test-register.mjs --test src/lib/*.test.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --config wrangler.jsonc",
    "deploy:with-env": "opennextjs-cloudflare build && wrangler deploy --config wrangler.jsonc --secrets-file .env.local",
    "upload": "opennextjs-cloudflare build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dodopayments/nextjs": "^0.3.9",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dodopayments": "^2.48.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vinext/cloudflare": "^1.3.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.32",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.4.5",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "type": "module"
}
